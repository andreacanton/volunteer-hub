# Volunteer Hub API - Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED - Application will fail to start without these
# =============================================================================

# JWT secret for signing tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-min-32-characters-here

# =============================================================================
# OPTIONAL - These have sensible defaults
# =============================================================================

# Server port (default: 3000)
PORT=3000

# Environment: development | production | test (default: development)
NODE_ENV=development

# JWT access token expiration time (default: 24h)
# Examples: 15m, 1h, 24h
JWT_EXPIRES_IN=24h

# JWT refresh token expiration time (default: 7d)
# Examples: 7d, 14d, 30d
JWT_REFRESH_EXPIRES_IN=7d

# Password reset token expiration time (default: 1h)
PASSWORD_RESET_EXPIRES_IN=1h

# SQLite database file path (default: ./database/volunteer-hub.db)
DATABASE_PATH=./database/volunteer-hub.db

# Logging level: trace | debug | info | warning | error | fatal (default: info)
LOG_LEVEL=info

# Frontend URL for password reset links (default: http://localhost:8080)
FRONTEND_URL=http://localhost:8080

# =============================================================================
# SMTP Configuration (Optional - password reset emails disabled if not set)
# =============================================================================

# SMTP server hostname
# SMTP_HOST=smtp.example.com

# SMTP server port (typically 587 for TLS, 465 for SSL)
# SMTP_PORT=587

# SMTP authentication username
# SMTP_USER=your-smtp-username

# SMTP authentication password
# SMTP_PASS=your-smtp-password

# Email sender address (From header)
# SMTP_FROM=noreply@example.com
