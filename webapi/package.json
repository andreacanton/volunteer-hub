{
  "name": "volunteer-hub-webapi",
  "version": "0.1.0",
  "description": "Volunteer Attendance Management API",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "start": "bun src/index.ts",
    "migrate": "bun src/database/migrate.ts",
    "test": "bun test",
    "test:bruno": "cd tests/bruno && bru run --env local",
    "test:bruno:ci": "cd tests/bruno && bru run --env local --reporter-junit ../../results/bruno-junit.xml",
    "test:bruno:health": "cd tests/bruno && bru run Health --env local",
    "test:bruno:auth": "cd tests/bruno && bru run Auth --env local",
    "test:bruno:user": "cd tests/bruno && bru run User --env local",
    "test:all": "bun test && bun run test:bruno",
    "seed:test": "bun run tests/bruno/seed-test-users.ts",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "latest",
    "@types/nodemailer": "^7.0.5",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@usebruno/cli": "^3.0.3",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@logtape/logtape": "^2.0.1",
    "elysia": "^1.4.22",
    "nodemailer": "^7.0.12"
  }
}
