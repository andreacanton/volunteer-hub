meta {
  name: Forgot Password Existing
  type: http
  seq: 11
}

post {
  url: {{base_url}}/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "test-user@example.com"
  }
}

tests {
  test("should return 200 status", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should have standard API response format", function() {
    const body = res.getBody();
    expect(body).to.have.property('success');
    expect(body).to.have.property('data');
    expect(body).to.have.property('error');
    expect(body).to.have.property('timestamp');
  });

  test("should indicate success", function() {
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.error).to.be.null;
  });

  test("should return generic message (no enumeration)", function() {
    const body = res.getBody();
    expect(body.data).to.have.property('message');
    expect(body.data.message).to.include('If an account');
  });
}

docs {
  # Forgot Password Existing Email Test

  This test verifies the forgot-password endpoint returns success for existing emails.
  The response message is intentionally generic to prevent email enumeration.

  **Prerequisites:**
  - The user `test-user@example.com` must exist in the database
}
