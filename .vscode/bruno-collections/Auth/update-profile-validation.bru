meta {
  name: Update Profile Validation
  type: http
  seq: 18
}

put {
  url: {{base_url}}/users/me
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{auth_token}}
}

script:pre-request {
  const token = bru.getVar("auth_token");
  if (token) {
    req.setHeader("Authorization", "Bearer " + token);
  }
}

body:json {
  {
    "email": "invalid-email"
  }
}

tests {
  test("should return 400 Bad Request status", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("should have standard API response format", function() {
    const body = res.getBody();
    expect(body).to.have.property('success');
    expect(body).to.have.property('data');
    expect(body).to.have.property('error');
    expect(body).to.have.property('timestamp');
  });

  test("should indicate failure", function() {
    const body = res.getBody();
    expect(body.success).to.be.false;
    expect(body.data).to.be.null;
  });

  test("should have VALIDATION_ERROR error code", function() {
    const body = res.getBody();
    expect(body.error).to.have.property('code');
    expect(body.error.code).to.equal('VALIDATION_ERROR');
  });
}

docs {
  # Update Profile Validation Test

  This test verifies that invalid data is rejected with validation errors.

  **Prerequisites:**
  - Run login-success.bru first to capture an auth_token
}
