meta {
  name: Forgot Password Nonexistent
  type: http
  seq: 12
}

post {
  url: {{base_url}}/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "nonexistent-user-12345@example.com"
  }
}

tests {
  test("should return 200 status (same as existing)", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should have standard API response format", function() {
    const body = res.getBody();
    expect(body).to.have.property('success');
    expect(body).to.have.property('data');
    expect(body).to.have.property('error');
    expect(body).to.have.property('timestamp');
  });

  test("should indicate success (prevents enumeration)", function() {
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.error).to.be.null;
  });

  test("should return same generic message as existing email", function() {
    const body = res.getBody();
    expect(body.data).to.have.property('message');
    expect(body.data.message).to.include('If an account');
  });
}

docs {
  # Forgot Password Nonexistent Email Test

  This test verifies the forgot-password endpoint returns the SAME success response
  for non-existent emails, preventing email enumeration attacks.
}
