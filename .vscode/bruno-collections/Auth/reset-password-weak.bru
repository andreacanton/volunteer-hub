meta {
  name: Reset Password Weak
  type: http
  seq: 15
}

post {
  url: {{base_url}}/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "some-token",
    "password": "short"
  }
}

tests {
  test("should return 400 Bad Request status", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("should have standard API response format", function() {
    const body = res.getBody();
    expect(body).to.have.property('success');
    expect(body).to.have.property('data');
    expect(body).to.have.property('error');
    expect(body).to.have.property('timestamp');
  });

  test("should indicate failure", function() {
    const body = res.getBody();
    expect(body.success).to.be.false;
    expect(body.data).to.be.null;
  });

  test("should have validation error", function() {
    const body = res.getBody();
    expect(body.error).to.have.property('code');
    expect(body.error.code).to.equal('VALIDATION_ERROR');
  });
}

docs {
  # Reset Password Weak Password Test

  This test verifies the reset-password endpoint rejects weak passwords
  (less than 8 characters) at the validation level.
}
