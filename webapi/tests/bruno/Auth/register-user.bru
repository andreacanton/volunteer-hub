meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{test_email_prefix}}-{{timestamp}}@example.com",
    "password": "{{test_password}}",
    "firstName": "Bruno",
    "lastName": "Test"
  }
}

script:pre-request {
  bru.setVar("timestamp", Date.now());
}

tests {
  test("should return 200 status", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should have standard API response format", function() {
    const body = res.getBody();
    expect(body).to.have.property('success');
    expect(body).to.have.property('data');
    expect(body).to.have.property('error');
    expect(body).to.have.property('timestamp');
  });

  test("should indicate success", function() {
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.error).to.be.null;
  });

  test("should have success message", function() {
    const body = res.getBody();
    expect(body.data).to.be.an('object');
    expect(body.data).to.have.property('message');
    expect(body.data.message).to.include('registered');
  });
}
